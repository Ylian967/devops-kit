# =============================================================================
# env.monitoring.example : modèle de monitoring/.env (versionné sous le nom
# monitoring/.env.example, valeurs factices). Lu par compose.monitoring.yaml.
#
# Sur la machine qui fait tourner la supervision :
#   cp monitoring/.env.example monitoring/.env && chmod 600 monitoring/.env
#   PASS=$(openssl rand -hex 24) && sed -i "s/changez-moi/$PASS/" monitoring/.env && echo "$PASS" && unset PASS
# Le vrai .env n'est JAMAIS versionné (.gitignore : monitoring/.env).
# Format : CLE=valeur, sans guillemets ni espaces autour du « = ».
# =============================================================================

# Mot de passe du compte « admin » de Grafana. Lu au PREMIER démarrage seulement
# (ensuite stocké dans le volume grafana-data).
GRAFANA_ADMIN_PASSWORD=changez-moi

# Ports publiés sur 127.0.0.1 (jamais sur toutes les interfaces). À changer
# seulement s'ils sont déjà pris sur la machine.
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
