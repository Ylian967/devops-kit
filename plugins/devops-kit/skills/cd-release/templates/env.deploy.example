# =============================================================================
# env.deploy.example : modèle du fichier $DEPLOY_DIR/.env d'UN environnement
# (staging ou production). Versionné dans deploy/env.example, valeurs factices.
#
# Sur le serveur, une fois par environnement :
#   cp deploy/env.example "$DEPLOY_DIR/.env" && chmod 600 "$DEPLOY_DIR/.env"
#   PASS=$(openssl rand -hex 24) && sed -i "s/changez-moi/$PASS/" "$DEPLOY_DIR/.env" && unset PASS
#   puis éditer les autres valeurs.
#
# Le vrai .env ne quitte JAMAIS le serveur : ni Git, ni secret GitHub. Le
# pipeline ne le lit pas, ne l'écrase pas ; il copie seulement compose.prod.yaml
# et deploy/ à côté.
# Format : CLE=valeur, sans guillemets ni espaces autour du « = » (lu par
# docker compose ET par deploy.sh).
# =============================================================================

# --- Identité de l'environnement (deploy.sh vérifie leur cohérence) ---------
# Nom du projet Compose : <repo>-<env>. Préfixe conteneurs, volume et réseau :
# staging et production cohabitent sur une même machine sans se mélanger.
COMPOSE_PROJECT_NAME=monapp-production
# staging ou production : renvoyé par /health, et garde-fou de deploy.sh.
APP_ENV=production

# --- Image -------------------------------------------------------------------
# ghcr.io/<owner>/<repo>, EN MINUSCULES. Le tag (SHA court) est choisi par deploy.sh.
IMAGE_NAME=ghcr.io/proprietaire/monapp

# --- Base de données -----------------------------------------------------------
# Mot de passe DIFFÉRENT par environnement : une fuite du staging n'ouvre pas la prod.
# `openssl rand -hex 24` : uniquement 0-9a-f, rien qui casse l'URL de connexion.
# Lu par PostgreSQL à la création du volume seulement : le changer ensuite
# demande un ALTER USER, pas seulement une modification de ce fichier.
POSTGRES_USER=app
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=app

# --- Proxy -------------------------------------------------------------------
# Ports publiés par le proxy (seul service exposé). Deux environnements sur la
# même machine : des ports différents, ex. staging 8081 / 8444.
HTTP_PORT=80
HTTPS_PORT=443

# --- Smoke test (deploy/smoke-test.sh, lancé par deploy.sh) --------------------
# URL de /health vue depuis l'endroit où tourne deploy.sh :
#   runner dans un conteneur : https://host.docker.internal:<HTTPS_PORT>/health
#   VPS (deploy.sh lancé en SSH sur le serveur) : https://localhost:<HTTPS_PORT>/health
#   VPS avec Let's Encrypt : https://app.example.com/health (le nom du certificat)
SMOKE_URL=https://localhost:443/health
# Certificat auto-signé (gen-cert.sh) : le VÉRIFIER plutôt que tout accepter (-k).
# Let's Encrypt : laisser vide (autorité reconnue par curl).
SMOKE_CURL_OPTS=--cacert certs/fullchain.pem

# --- Options -------------------------------------------------------------------
# Commande de migration lancée dans un conteneur `app` jetable avant la mise en
# ligne (vide = aucune). Exemples : npx prisma migrate deploy | bin/migrate
MIGRATE_CMD=
# always : tirer les images à chaque déploiement (correctifs de nginx et postgres)
PULL_POLICY=always

# --- Variables propres à l'application ------------------------------------------
# Une ligne par variable, et la même variable dans `environment:` de compose.prod.yaml.
# SECRET_KEY_BASE=changez-moi
