# .env du runner (copie de env.example). JAMAIS versionné : il contient un jeton.

# Adresse de VOTRE dépôt
REPO_URL=https://github.com/proprietaire/monapp

# Jeton d'ENREGISTREMENT : dépôt → Settings → Actions → Runners → New self-hosted
# runner, la valeur après `--token`. Valable 1 heure, utilisé une seule fois.
# Ou en ligne de commande : gh api -X POST repos/<owner>/<repo>/actions/runners/registration-token --jq .token
RUNNER_TOKEN=

RUNNER_NAME=deploy-runner

# Dossier qui contient les dossiers des environnements, CHEMIN ABSOLU (pas de ~) :
#   $DEPLOY_ROOT/monapp-staging et $DEPLOY_ROOT/monapp-production
# Ce sont les variables DEPLOY_DIR des environments GitHub.
# WSL2 : un chemin Linux (/home/...), pas /mnt/c/...
DEPLOY_ROOT=/home/vous/deploy
