# =============================================================================
# .env.example : modèle du fichier .env lu par `docker compose` (développement)
#
#   cp .env.example .env      # puis changer les valeurs si besoin
#
# .env.example est VERSIONNÉ et ne contient que des valeurs FACTICES.
# .env n'est JAMAIS versionné (il est dans .gitignore) : il peut contenir de
# vrais secrets (clé d'API de test, mot de passe partagé…).
# Sans .env, compose.yaml démarre quand même avec ses valeurs par défaut.
# =============================================================================

# --- Base de données (service db) -------------------------------------------
# Utilisés à la création de la base (premier démarrage, volume pgdata vide).
# Après un changement : `docker compose down -v` pour recréer la base.
POSTGRES_USER=app
POSTGRES_PASSWORD=app-dev-factice
POSTGRES_DB=app

# --- Application -------------------------------------------------------------
# Port publié sur 127.0.0.1 (à changer si 3000 est déjà pris sur le poste).
APP_PORT=3000

# Lancer l'application HORS Docker (npm start, cargo run…) contre la base du
# compose : décommenter `ports:` du service db dans compose.yaml, puis
# DATABASE_URL=postgres://app:app-dev-factice@localhost:5432/app
