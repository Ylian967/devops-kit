# syntax=docker/dockerfile:1
# =============================================================================
# Dockerfile : API Node (node:http, Express, Fastify…) — build multi-stage
#
#   deps     dépendances de PRODUCTION seulement (npm ci --omit=dev)
#   build    toutes les dépendances + `npm run build` (TypeScript, bundler…)
#            → à SUPPRIMER si package.json n'a pas de script build
#   runtime  image finale : Node + node_modules de prod + code, sans npm cache,
#            sans dépendances de dev, lancée par l'utilisateur `node` (non root)
#
# Construire :  docker build --build-arg APP_VERSION=$(git rev-parse --short=7 HEAD) -t monapp .
# Modèle à ADAPTER : version de Node, dossiers copiés, commande de démarrage.
# =============================================================================

# Version de Node définie UNE fois, utilisée par toutes les étapes.
# Version précise (pas `22-alpine`) : le même Dockerfile produit la même image
# dans six mois. Même version majeure que la CI (NODE_VERSION de ci.yml).
ARG NODE_IMAGE=node:22.23.5-alpine3.24

# ---------- deps : dépendances de production ---------------------------------
FROM ${NODE_IMAGE} AS deps
WORKDIR /app
# On copie D'ABORD les seuls fichiers de dépendances : tant qu'ils ne changent
# pas, Docker réutilise la couche `npm ci` (cache) au lieu de tout réinstaller.
COPY package.json package-lock.json ./
# --mount=type=cache : le cache npm reste sur la machine de build, pas dans l'image.
# --omit=dev : ni ESLint ni outils de test dans l'image finale.
RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev

# ---------- build : compilation (à supprimer s'il n'y a rien à compiler) -----
FROM ${NODE_IMAGE} AS build
WORKDIR /app
COPY package.json package-lock.json ./
# Ici TOUTES les dépendances : le compilateur (tsc, esbuild…) est une dépendance de dev.
RUN --mount=type=cache,target=/root/.npm npm ci
COPY . .
# Produit dist/ (adapter au dossier de sortie réel du projet)
RUN npm run build

# ---------- runtime : l'image qui tourne ---------------------------------------
FROM ${NODE_IMAGE} AS runtime
# NODE_ENV=production : Express & co désactivent leurs aides de debug.
# PORT : port d'écoute lu par l'application (convention devops-kit : 3000 pour Node).
ENV NODE_ENV=production \
    PORT=3000
WORKDIR /app
# Les fichiers appartiennent à root et sont seulement LISIBLES par `node` :
# un attaquant qui prend la main sur le processus ne peut pas réécrire le code.
COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
# Le code compilé (étape build). Sans étape build : COPY src ./src à la place.
COPY --from=build /app/dist ./dist

# Version affichée par /health. La CI passe le SHA court : --build-arg APP_VERSION=<sha>.
# Placé APRÈS les COPY : changer de version n'invalide pas le cache des couches précédentes.
ARG APP_VERSION=dev
ENV APP_VERSION=${APP_VERSION}

# Utilisateur non root : `node` (uid 1000) existe déjà dans l'image officielle.
# Uid NUMÉRIQUE : Kubernetes (runAsNonRoot) et les scanners peuvent vérifier
# sans lire /etc/passwd de l'image que ce n'est pas root (0).
USER 1000:1000

# Documentaire : publier le port se fait avec -p ou `ports:` dans compose.yaml.
EXPOSE 3000

# Healthcheck SANS curl ni wget : Node 22 a fetch() intégré. Code de sortie 0 si
# /health répond 2xx, 1 sinon (503 = base injoignable, ou aucune réponse).
# 3 échecs de suite → conteneur `unhealthy` ; start-period laisse le temps de démarrer.
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/health').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]

# Forme exec (tableau) : Node est le PID 1 et reçoit SIGTERM de `docker stop`.
# Jamais `npm start` : npm ne relaie pas toujours les signaux (arrêt brutal après 10 s).
CMD ["node", "dist/server.js"]
