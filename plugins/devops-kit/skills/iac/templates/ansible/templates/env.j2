{# =============================================================================
   env.j2 : le .env d'UN environnement Compose (production), rendu par site.yml
   UNE SEULE FOIS (force: false). Mêmes clés que deploy/env.example (bloc
   cd-release) : garder les deux fichiers alignés.
   Ce commentaire Jinja n'apparaît pas dans le fichier produit.
   ============================================================================= #}
# {{ ansible_managed }} le {{ now(fmt='%Y-%m-%d') }}, puis à vous : site.yml ne le réécrit jamais.
# Modèle : deploy/env.example. Format CLE=valeur, sans guillemets.

# --- Identité de l'environnement (deploy.sh vérifie leur cohérence) ---------
COMPOSE_PROJECT_NAME={{ projet }}-{{ item.key }}
APP_ENV={{ item.key }}

# --- Image -------------------------------------------------------------------
IMAGE_NAME={{ image_name }}

# --- Base de données -----------------------------------------------------------
# Tiré au hasard à la création du fichier, différent pour chaque environnement.
POSTGRES_USER=app
POSTGRES_PASSWORD={{ lookup('ansible.builtin.password', '/dev/null', chars=['ascii_lowercase', 'digits'], length=40) }}
POSTGRES_DB=app

# --- Proxy -------------------------------------------------------------------
HTTP_PORT={{ item.value.http_port | default(80) }}
HTTPS_PORT={{ item.value.https_port | default(443) }}

# --- Smoke test ----------------------------------------------------------------
SMOKE_URL={{ item.value.smoke_url | default('https://localhost:' ~ (item.value.https_port | default(443)) ~ '/health') }}
SMOKE_CURL_OPTS={{ item.value.smoke_curl_opts | default('--cacert certs/fullchain.pem') }}

# --- Options -------------------------------------------------------------------
MIGRATE_CMD=
PULL_POLICY=always

# --- Variables propres à l'application ------------------------------------------
