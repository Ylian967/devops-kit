{
  "name": "node-api-exemple",
  "version": "0.1.0",
  "private": true,
  "description": "Mini-API Node (node:http + PostgreSQL) pour tester les blocs de devops-kit",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test 'tests/unit/**/*.test.js'",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/server.js' 'tests/unit/**/*.test.js'",
    "test:int": "node --test 'tests/int/**/*.test.js'"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
